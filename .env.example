# Sao chép file này thành .env rồi điền giá trị: cp .env.example .env
# KHÔNG commit file .env.

# ---------- Airflow ----------
# Linux/macOS: chạy `id -u`. Windows: để 50000.
AIRFLOW_UID=50000
# Sinh bằng: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Chuỗi ngẫu nhiên dài, ví dụ: openssl rand -hex 32
AIRFLOW__API_AUTH__JWT_SECRET=
# Đường dẫn tuyệt đối tới thư mục dự án trên MÁY HOST (DAG dùng để mount vào container Spark).
# Ví dụ Windows: F:/Project/realtime-lakehouse    Ví dụ Linux: /home/you/realtime-lakehouse
HOST_PROJECT_DIR=

# ---------- MinIO (S3) ----------
# Mật khẩu tối thiểu 8 ký tự.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ---------- Postgres của Nessie ----------
NESSIE_DB_USER=
NESSIE_DB_PASSWORD=
