# Sao chép file này thành .env rồi điền giá trị: cp .env.example .env
# KHÔNG commit file .env.

# ---------- Airflow ----------
# Linux/macOS: chạy `id -u`. Windows: để 50000.
AIRFLOW_UID=50000
# Sinh bằng: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
# Chuỗi ngẫu nhiên dài, ví dụ: openssl rand -hex 32
AIRFLOW__API_AUTH__JWT_SECRET=
# Đường dẫn tuyệt đối tới thư mục dự án trên MÁY HOST (DAG dùng để mount vào container Spark).
# Ví dụ Windows: F:/Project/realtime-lakehouse    Ví dụ Linux: /home/you/realtime-lakehouse
HOST_PROJECT_DIR=

# ---------- MinIO (S3) ----------
# Mật khẩu tối thiểu 8 ký tự.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ---------- Postgres của Nessie ----------
NESSIE_DB_USER=
NESSIE_DB_PASSWORD=

# ---------- ClickHouse + Superset (BI) ----------
# Mật khẩu chỉ nên gồm chữ và số (được chèn thẳng vào câu SQL và URI kết nối), ví dụ: openssl rand -hex 16
# Mật khẩu user quản trị `admin` của ClickHouse
CLICKHOUSE_PASSWORD=
# Mật khẩu user `superset` (chỉ đọc) mà Superset dùng để truy vấn ClickHouse
CLICKHOUSE_SUPERSET_PASSWORD=
# Khóa mã hóa mật khẩu kết nối lưu trong Superset, ví dụ: openssl rand -hex 32
# Đặt một lần rồi giữ nguyên: đổi khóa này thì Superset không giải mã được các mật khẩu đã lưu.
SUPERSET_SECRET_KEY=
